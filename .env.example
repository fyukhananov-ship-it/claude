# Database
DATABASE_URL=postgresql+asyncpg://clo:clo_secret@db:5432/clo_db

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=change-me-in-production-very-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Platform financials
PLATFORM_COMMISSION_RATE=0.036
REVSHARE_TRAFFIC_HOLDER=0.20
REVSHARE_NSPK=0.17
REVSHARE_BEELINE=0.10

# Anti-fraud
ANTIFRAUD_MAX_ACCRUALS_PER_DAY=3
ANTIFRAUD_TERMINAL_SPIKE_THRESHOLD=0.50
