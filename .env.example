# ═══════════════════════════════════════════════════════════
# CLO Backend — Production .env template
# Copy this file to .env on your Yandex Cloud VM and fill in
# real values. Never commit .env to git.
# ═══════════════════════════════════════════════════════════

# ─── Backend image (from Yandex Container Registry) ───
# Set after first GitHub Actions build. Format:
# cr.yandex/<registry-id>/clo-backend:latest
BACKEND_IMAGE=cr.yandex/<YOUR_REGISTRY_ID>/clo-backend:latest

# ─── Managed PostgreSQL (Yandex Cloud) ───
# Port 6432 = PgBouncer (default for Managed Postgres).
# ssl=require enables TLS; verify-full uses the root CA baked into the image.
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:6432/<DB_NAME>?ssl=require

# ─── Managed Valkey / Redis (Yandex Cloud) ───
# For TLS use rediss:// (port 6380 for Yandex TLS-enabled clusters).
REDIS_URL=redis://default:<REDIS_PASSWORD>@<REDIS_HOST>:6379/0
CACHE_TTL_SECONDS=60
CACHE_ENABLED=true

# ─── Auth ───
# Generate with:  openssl rand -hex 32
JWT_SECRET=<GENERATE_A_64_CHAR_RANDOM_HEX_STRING>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── File storage backend ───
# "s3"    — Yandex Object Storage (production)
# "local" — /app/uploads volume (dev only)
STORAGE_BACKEND=s3
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=2097152

# ─── Yandex Object Storage (S3-compatible) ───
S3_ENDPOINT_URL=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET_UPLOADS=beeline-clo-uploads
# Optional override for public URLs. Leave empty for default.
# Example when using CDN: https://cdn.yourdomain.ru
S3_PUBLIC_BASE_URL=

# Static key from service account beeline-clo-app (created in YC console)
YC_ACCESS_KEY=<YCAJE...>
YC_SECRET_KEY=<YCN...>

# ─── CORS ───
# Comma-separated frontend origins. Use "*" only for local dev.
CORS_ORIGINS=http://111.88.146.100,https://beeline-clo-static.website.yandexcloud.net

# ─── Business rules (keep defaults unless you know what you're doing) ───
PLATFORM_COMMISSION_RATE=0.036
REVSHARE_TRAFFIC_HOLDER=0.20
REVSHARE_NSPK=0.17
REVSHARE_BEELINE=0.10

ANTIFRAUD_MAX_ACCRUALS_PER_DAY=3
ANTIFRAUD_TERMINAL_SPIKE_THRESHOLD=0.50
